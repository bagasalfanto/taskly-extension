{
  "manifest_version": 3,
  "name": "Taskly",
  "description": "Menyimpan tugas, catatan, dan link langsung dari browser.",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "tabs",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "assets/favicon.svg",
    "32": "assets/favicon.svg",
    "48": "assets/favicon.svg",
    "128": "assets/favicon.svg"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Taskly",
    "default_icon": {
      "16": "assets/favicon.svg",
      "32": "assets/favicon.svg",
      "48": "assets/favicon.svg",
      "128": "assets/favicon.svg"
    },
    "default_popup": "popup/popup.html"
  },
  "options_page": "dashboard/dashboard.html"
}
